<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: sans-serif; user-select: none; -webkit-user-select: none; }
        
        /* NUCLEAR OPTION: Full screen overlay to hide EVERYTHING including boot text */
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #050505; z-index: 99999999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }

        .logo-pulse {
            width: 150px; height: 150px; margin-bottom: 30px;
            animation: pulse 2s infinite ease-in-out;
            background: url('icon.png') no-repeat center; background-size: contain;
        }
        @keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(0.95); opacity: 0.8; } }

        .loading-text {
            font-size: 14px; color: #888; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px;
        }

        #canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); outline: none; z-index: 10; }
        
        /* Aggressively hide Pygbag artifacts */
        #status, #output, #console, #loading { display: none !important; visibility: hidden !important; opacity: 0 !important; }
    </style>
</head>
<body>
    <!-- The Safety Curtain -->
    <div id="boot-overlay">
        <div class="logo-pulse"></div>
        <div class="loading-text">Initializing Premium Experience...</div>
    </div>

    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
#<!--
import sys
import asyncio
import platform
import json
from pathlib import Path

# Stub window if needed
if not hasattr(platform, 'window'):
    class MockWindow:
        def __getattr__(self, name): return None
    platform.window = MockWindow()

async def custom_site():
    try:
        # 1. Mount APK
        apk = "{{cookiecutter.archive}}.apk"
        bundle = "{{cookiecutter.archive}}"
        appdir = Path(f"/data/data/{bundle}")
        appdir.mkdir(parents=True, exist_ok=True)

        cfg = {"io": "url", "type": "mount", "mount": {"point": appdir.as_posix(), "path": "/"}, "path": f"/ => {appdir.as_posix()}"}
        
        if hasattr(platform.window, 'MM'):
            track = platform.window.MM.prepare(apk, json.dumps(cfg))
            while not track.ready:
                await asyncio.sleep(0.1)

        # 2. Setup Path
        if appdir.as_posix() not in sys.path:
            sys.path.append(appdir.as_posix())

        # 3. DROP THE CURTAIN: Only now do we remove the overlay
        try:
             platform.window.document.getElementById("boot-overlay").style.display = "none"
        except: 
             pass

        # 4. Start Game
        import main
        await main.main()

    except Exception as e:
        # In case of error, show it on the overlay text
        try:
            err_msg = str(e)
            platform.window.document.querySelector(".loading-text").innerText = "ERROR: " + err_msg
        except:
             print(f"CRITICAL: {e}")

# -->
    </script>
</body>
</html>
