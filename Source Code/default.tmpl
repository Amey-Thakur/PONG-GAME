<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: sans-serif; user-select: none; -webkit-user-select: none; }
        #canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); outline: none; }
        #loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none; }
        .spinner {
            width: 50px; height: 50px; border: 5px solid #333; border-top: 5px solid #fff;
            border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px auto;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        /* Hide Default Pygbag UI Artifacts */
        #status, #output, #console { display: none !important; }
    </style>
</head>
<body>
    <div id="loading">
        <div class="spinner"></div>
        <div>LOADING PONG GAME...</div>
    </div>
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
#<!--
import sys
import asyncio
import platform
import json
from pathlib import Path

# Fix for platform.window in some environments
if not hasattr(platform, 'window'):
    class MockWindow:
        def __getattr__(self, name): return None
    platform.window = MockWindow()

async def custom_site():
    try:
        # 1. Mount APK
        apk = "{{cookiecutter.archive}}.apk"
        bundle = "{{cookiecutter.archive}}"
        appdir = Path(f"/data/data/{bundle}")
        appdir.mkdir(parents=True, exist_ok=True)

        # Mount configuration
        cfg = {"io": "url", "type": "mount", "mount": {"point": appdir.as_posix(), "path": "/"}, "path": f"/ => {appdir.as_posix()}"}
        
        # Check if MM (Mount Manager) is available, otherwise basic sleep (shouldn't happen in browser)
        if hasattr(platform.window, 'MM'):
            track = platform.window.MM.prepare(apk, json.dumps(cfg))
            while not track.ready:
                await asyncio.sleep(0.1)
        else:
            print("Warning: MM not found, skipping mount wait.")

        # 2. Add to sys.path
        if appdir.as_posix() not in sys.path:
            sys.path.append(appdir.as_posix())

        # 3. Clean up UI
        try:
             platform.window.document.getElementById("loading").style.display = "none"
        except: 
             pass

        # 4. Run Main
        import main
        await main.main()

    except Exception as e:
        print(f"CRITICAL ERROR: {e}")
        import traceback
        traceback.print_exc()

# -->
    </script>
</body>
</html>
