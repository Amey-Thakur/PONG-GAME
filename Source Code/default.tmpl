<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            background-color: #0a0a0a;
            font-family: 'Outfit', 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }
        
        #canvas {
            display: block;
            outline: none;
        }
        
        /* Theme the Pygbag "Ready to start" button */
        button, input[type="button"] {
            background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%) !important;
            color: #ffffff !important;
            border: 2px solid #333333 !important;
            border-radius: 12px !important;
            padding: 18px 60px !important;
            font-family: 'Outfit', 'Segoe UI', sans-serif !important;
            font-size: 18px !important;
            font-weight: 600 !important;
            letter-spacing: 2px !important;
            text-transform: uppercase !important;
            cursor: pointer !important;
            transition: all 0.3s ease !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5) !important;
        }
        
        button:hover, input[type="button"]:hover {
            background: linear-gradient(180deg, #252525 0%, #151515 100%) !important;
            border-color: #00ff7f !important;
            box-shadow: 0 4px 30px rgba(0, 255, 127, 0.2) !important;
            transform: scale(1.02) !important;
        }
        
        /* Hide console/status */
        #status, #output, #console, pre { 
            display: none !important; 
        }
    </style>
</head>
<body>
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
    
    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type="module" 
            id="site" 
            data-python="python3.11" 
            data-os="vtx,fs,snd,gui"
            async defer>
    </script>
</body>
</html>
