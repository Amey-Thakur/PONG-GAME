<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Outfit', sans-serif; user-select: none; -webkit-user-select: none; }
        
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #050505; z-index: 9999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s;
        }

        .logo { width: 100px; height: 100px; margin-bottom: 25px; background: url('icon.png') no-repeat center; background-size: contain; }
        .loading-text { font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px; font-weight: bold; }

        /* FAST CSS LOADER */
        #progress-container { width: 300px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; }
        #progress-fill { width: 0%; height: 100%; background: #ffffff; animation: load 4s ease-out forwards; }
        @keyframes load { 0% { width: 0%; } 100% { width: 95%; } }

        #canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; outline: none; }
        #status, #output, #console { display: none !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo"></div>
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text">INITIALIZING PONG GAME...</div>
    </div>
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script>
        // FAILSAFE: Force remove overlay after 5 seconds NO MATTER WHAT
        // This ensures the user NEVER sees a stuck screen indefinitely.
        setTimeout(() => {
            const overlay = document.getElementById('boot-overlay');
            if(overlay) {
                overlay.style.opacity = '0';
                setTimeout(() => overlay.style.display = 'none', 500);
            }
        }, 5000); // 5 Seconds Max Wait via JS
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
