async def custom_site():
    try:
        # 1. Mount APK
        apk = "{{cookiecutter.archive}}.apk"
        bundle = "{{cookiecutter.archive}}"
        appdir = Path(f"/data/data/{bundle}")
        appdir.mkdir(parents=True, exist_ok=True)

        cfg = {"io": "url", "type": "mount", "mount": {"point": appdir.as_posix(), "path": "/"}, "path": f"/ => {appdir.as_posix()}"}
        
        if hasattr(platform.window, 'MM'):
            platform.window.MM.prepare(apk, json.dumps(cfg))
            # Just wait a bit for mount, don't block forever
            await asyncio.sleep(1.0)

        # 2. Setup Path
        if appdir.as_posix() not in sys.path:
            sys.path.append(appdir.as_posix())

        # 3. Call JS to finish visual load
        try:
             platform.window.finishLoad()
        except: pass

        # 4. Start Game
        import main
        await main.main()

    except Exception as e:
        print(f"CRITICAL: {e}")
        # Even if error, remove overlay so we can see
        try:
             platform.window.document.getElementById("boot-overlay").style.display = "none"
        except: pass

# -->
    </script>
</body>
</html>
