<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        /* PRO-GRADE SUPPRESSION: Everything is invisible by default */
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Outfit', sans-serif; user-select: none; -webkit-user-select: none; visibility: hidden; }
        
        /* WHITELIST: Only allowing our Overlay and Game Canvas to be seen */
        #boot-overlay {
            visibility: visible;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #050505; z-index: 99999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s;
        }

        #canvas { 
            visibility: visible;
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; outline: none; z-index: 10; 
        }

        .logo { width: 100px; height: 100px; margin-bottom: 25px; background: url('icon.png') no-repeat center; background-size: contain; }
        .loading-text { font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px; font-weight: bold; }

        #progress-container { width: 300px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; }
        #progress-fill { width: 0%; height: 100%; background: #ffffff; animation: load 6s cubic-bezier(0.1, 0.7, 1.0, 0.1) forwards; }
        @keyframes load { 0% { width: 0%; } 100% { width: 92%; } }

        /* Nuking Pygbag artifacts */
        #status, #output, #console { display: none !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo"></div>
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text" id="status-text">INITIALIZING PONG GAME...</div>
    </div>

    <!-- The actual game canvas -->
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script>
        // Only called when the game is ACTUALLY ready
        window.finishLoad = function() {
            const bar = document.getElementById('progress-fill');
            const overlay = document.getElementById('boot-overlay');
            
            // Complete the bar visual
            bar.style.animation = 'none';
            bar.style.width = '100%';
            
            // Fade out the overlay to reveal the game
            setTimeout(() => {
                overlay.style.opacity = '0';
                setTimeout(() => overlay.style.display = 'none', 500);
            }, 200);
        };
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
