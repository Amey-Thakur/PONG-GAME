<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Outfit', sans-serif; user-select: none; -webkit-user-select: none; }
        
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #050505; z-index: 1000;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s;
        }

        .logo {
            width: 120px; height: 120px; margin-bottom: 30px;
            background: url('icon.png') no-repeat center; background-size: contain;
        }

        .loading-text {
            font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px; font-weight: bold;
        }

        #progress-container { width: 300px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; }
        #progress-fill { 
            width: 0%; height: 100%; background: #ffffff; 
            /* CSS Animation: 0% to 90% in 10 seconds. Never gets stuck. */
            animation: load 8s cubic-bezier(0.1, 0.7, 1.0, 0.1) forwards; 
        }
        
        @keyframes load { 0% { width: 0%; } 100% { width: 90%; } }

        #canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; outline: none; }
        #status, #output, #console { display: none !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo"></div>
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text" id="status-text">INITIALIZING PONG GAME...</div>
    </div>

    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script>
        window.finishLoad = function() {
            const bar = document.getElementById('progress-fill');
            const overlay = document.getElementById('boot-overlay');
            // Snap to 100%
            bar.style.animation = 'none';
            bar.style.width = '100%';
            // Hide
            setTimeout(() => {
                overlay.style.opacity = '0';
                setTimeout(() => overlay.style.display = 'none', 500);
            }, 200);
        };
        
        // Critical Error Handler
        window.showError = function(msg) {
            const txt = document.getElementById('status-text');
            txt.innerText = "ERROR: " + msg;
            txt.style.color = "#ff4444";
            document.getElementById('progress-container').style.display = 'none';
        };
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
#<!--
import sys
import asyncio
import platform
import json
from pathlib import Path

# Stub window
if not hasattr(platform, 'window'):
    class MockWindow:
        def __getattr__(self, name): return None
    platform.window = MockWindow()

async def custom_site():
    try:
        # 1. Mount Archive
        apk = "{{cookiecutter.archive}}.apk"
        bundle = "{{cookiecutter.archive}}"
        appdir = Path(f"/data/data/{bundle}")
        appdir.mkdir(parents=True, exist_ok=True)

        cfg = {"io": "url", "type": "mount", "mount": {"point": appdir.as_posix(), "path": "/"}, "path": f"/ => {appdir.as_posix()}"}
        
        if hasattr(platform.window, 'MM'):
            platform.window.MM.prepare(apk, json.dumps(cfg))
        
        # 2. Add Path
        if appdir.as_posix() not in sys.path:
            sys.path.append(appdir.as_posix())

        # 3. SAFETY WAIT: Give 3 seconds for mount to stabilize
        # This is safer than a potentially infinite 'while not ready' loop
        await asyncio.sleep(3.0)

        # 4. Import & Launch
        import main
        
        # 5. Success
        try: platform.window.finishLoad()
        except: pass

        await main.main()

    except Exception as e:
        try: platform.window.showError(f"{e}")
        except: print(e)

# -->
    </script>
</body>
</html>
