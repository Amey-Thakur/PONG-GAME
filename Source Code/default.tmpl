<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Roboto', sans-serif; user-select: none; -webkit-user-select: none; }
        
        /* Full screen overlay */
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #050505; z-index: 99999999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s ease-out;
        }

        .logo-pulse {
            width: 120px; height: 120px; margin-bottom: 20px;
            animation: pulse 2s infinite ease-in-out;
            background: url('icon.png') no-repeat center; background-size: contain;
        }
        @keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(0.95); opacity: 0.8; } }

        .loading-text {
            font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 15px; font-weight: bold;
        }

        /* GAME BAR - Apple Style (Above Text) */
        #progress-container { width: 300px; height: 6px; background: #222; margin-top: 20px; border-radius: 3px; overflow: hidden; }
        #progress-fill { width: 0%; height: 100%; background: #00ff7f; transition: width 0.1s; } /* Spring Green */

        #canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); outline: none; z-index: 10; font-family: 'Roboto', sans-serif; }
        
        /* Hide Pygbag Console */
        #status, #output, #console { display: none !important; visibility: hidden !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo-pulse"></div>
        <!-- Bar above Text -->
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text" id="status-text">INITIALIZING PONG GAME...</div>
    </div>

    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <!-- JS WATCHDOG & FAKE LOADER -->
    <script>
        // 1. Fake Loader: Moves bar to 90% over 5 seconds
        let progress = 0;
        const bar = document.getElementById('progress-fill');
        const interval = setInterval(() => {
            if (progress < 90) {
                progress += Math.random() * 5;
                bar.style.width = Math.min(progress, 90) + '%';
            }
        }, 200);

        // 2. Watchdog: Force Remove Overlay after 8 seconds max
        setTimeout(() => {
            const overlay = document.getElementById('boot-overlay');
            if (overlay) overlay.style.display = 'none';
        }, 8000);

        // Helper for Python to finish
        window.finishLoad = function() {
            clearInterval(interval);
            bar.style.width = '100%';
            setTimeout(() => {
                const overlay = document.getElementById('boot-overlay');
                if (overlay) {
                    overlay.style.opacity = '0';
                    setTimeout(() => overlay.style.display = 'none', 500);
                }
            }, 200);
        };
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
#<!--
