# screen pixels (real, hardware)
WIDTH=1280
HEIGHT=720

# reference/idealized screen pixels
REFX = 1980
REFY = 1080

def u(real, ref, v):
    if abs(v)<0.9999999:
        result = int( (float(real)/100.0) * (v*1000))
        if v<0:
            return real-result
        return result
    return int( (real/ref) * v )

def ux(*argv):
    global WIDTH, REFX
    acc = 0
    for v in argv:
        acc += u(WIDTH, REFX, v)
    return acc

def uy(*argv):
    global HEIGHT, REFY
    acc = 0
    for v in argv:
        acc += u(HEIGHT, REFY, v)
    return acc

# do not rename
async def custom_site():
    import sys
    import asyncio
    import platform
    import json
    import random
    import math
    from pathlib import Path
    import embed
    import pygame

    # THEME: Obsidian Background
    platform.document.body.style.background = "#050505"

    def compose():
        pygame.display.update()
        window.chromakey(None, *screen.get_colorkey(), 40)

    pygame.init()
    pygame.font.init()

    screen = pygame.display.set_mode([ux(.100),uy(.100)], pygame.SRCALPHA, 32)
    screen.set_colorkey( (0,0,0,0), pygame.RLEACCEL )
    screen.fill( (0,0,0,0) )

    compose()

    platform.window.transfer.hidden = true
    platform.window.canvas.style.visibility = "visible"

    apk = "{{cookiecutter.archive}}.apk"
    bundle = "{{cookiecutter.archive}}"

    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    # Pre-initialize Stars for the loader
    stars = []
    for _ in range(50):
        stars.append([random.randint(0, WIDTH), random.randint(0, HEIGHT), random.uniform(0.2, 1.5)])

    try:
        icon_orig = pygame.image.load("icon.png").convert_alpha()
    except:
        icon_orig = None

    def pg_bar(pos, total):
        screen.fill((20,20,20)) # Match main.py bg_color
        
        # Draw Starfield for premium feel during load
        for star in stars:
            star[1] += star[2]
            if star[1] > HEIGHT:
                star[1] = 0
                star[0] = random.randint(0, WIDTH)
            color_val = int(star[2] * 80) + 40
            pygame.draw.circle(screen, (color_val, color_val, color_val), (int(star[0]), int(star[1])), max(1, int(star[2] * 1.2)))
        
        # Arena Border
        pygame.draw.rect(screen, (220, 220, 220), (2, 2, WIDTH - 4, HEIGHT - 4), 4)

        bar_width = 460
        bar_height = 6
        bx = WIDTH/2 - bar_width/2
        by = HEIGHT/2 + 100
        
        progress = min(pos / (total or 1), 1.0)
        
        # Pulse Icon
        if icon_orig:
            pulse = 1.0 + 0.05 * math.sin(pygame.time.get_ticks() * 0.005)
            icon = pygame.transform.scale(icon_orig, (int(300 * pulse), int(300 * pulse)))
            screen.blit(icon, icon.get_rect(centerx=WIDTH/2, bottom=HEIGHT/2 + 80))

        # Progress bar
        pygame.draw.rect(screen, (40, 40, 40), (bx-2, by-2, bar_width+4, bar_height+4), border_radius=10)
        pygame.draw.rect(screen, (255,255,255), (bx, by, bar_width * progress, bar_height), border_radius=10)
        
        # Text
        try:
            f = pygame.font.Font(None, 24)
            lt = f.render("INITIALIZING ARCADE CORE...", True, (220, 220, 220))
            screen.blit(lt, lt.get_rect(center=(WIDTH/2, by + 40)))
        except:
            pass

    # mount apk
    cfg = {
        "io": "url",
        "type":"mount",
        "mount" : {
            "point" : appdir.as_posix(),
            "path" : "/",
        },
        "path" : f"/ => {appdir.as_posix()}",
    }

    track = platform.window.MM.prepare(apk, json.dumps(cfg))

    # wait until zip mount + overlayfs is complete
    while not track.ready:
        pg_bar(track.pos, track.len)
        compose()
        await asyncio.sleep(.01)

    pg_bar(track.len, track.len)
    compose()

