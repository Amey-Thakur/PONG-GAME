<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: #050505; color: #eee; font-family: 'Outfit', sans-serif; overflow: hidden; user-select: none; visibility: hidden; }
        
        #boot-overlay {
            visibility: visible;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #050505; z-index: 99999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.5s;
        }
        
        .logo { width: 120px; height: 120px; margin-bottom: 30px; background: url('icon.png') no-repeat center; background-size: contain; }
        #progress-container { width: 300px; height: 4px; background: #222; border-radius: 2px; overflow: hidden; }
        #progress-fill { width: 0%; height: 100%; background: #fff; animation: load 5s ease-out forwards; }
        @keyframes load { 0% { width: 0%; } 100% { width: 90%; } }
        .loading-text { font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px; font-weight: bold; }
        
        #canvas { visibility: visible; position: absolute; top: 0; left: 0; width: 100%; height: 100%; outline: none; z-index: 10; }
        #status, #output, #console { display: none !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo"></div>
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text">INITIALIZING PONG GAME...</div>
    </div>
    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script>
        // Reveal game when ready
        window.finishLoad = function() {
            var bar = document.getElementById('progress-fill');
            var overlay = document.getElementById('boot-overlay');
            bar.style.animation = 'none';
            bar.style.width = '100%';
            setTimeout(function() {
                overlay.style.opacity = '0';
                setTimeout(function() { overlay.style.display = 'none'; }, 500);
            }, 200);
        };
        
        // FAILSAFE: Force remove after 8 seconds
        setTimeout(function() {
            var overlay = document.getElementById('boot-overlay');
            if (overlay && overlay.style.display !== 'none') {
                overlay.style.opacity = '0';
                setTimeout(function() { overlay.style.display = 'none'; }, 500);
            }
        }, 8000);
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" type="module" id="site" data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
