<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Roboto', sans-serif; user-select: none; -webkit-user-select: none; }
        
        /* Full screen overlay */
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #050505; z-index: 99999999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }

        .logo-pulse {
            width: 120px; height: 120px; margin-bottom: 30px;
            animation: pulse 2s infinite ease-in-out;
            background: url('icon.png') no-repeat center; background-size: contain;
        }
        @keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(0.95); opacity: 0.8; } }

        .loading-text {
            font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 20px; font-weight: bold;
        }

        /* GAME BAR - Apple Style (Above Text) */
        #progress-container { width: 300px; height: 6px; background: #222; margin-top: 0px; border-radius: 3px; overflow: hidden; margin-bottom: 20px; }
        #progress-fill { width: 0%; height: 100%; background: #00ff7f; transition: width 0.1s; } /* Spring Green */

        #canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); outline: none; z-index: 10; font-family: 'Roboto', sans-serif; }
        
        /* Hide Pygbag Console */
        #status, #output, #console { display: none !important; visibility: hidden !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo-pulse"></div>
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text" id="status-text">INITIALIZING PONG GAME...</div>
    </div>

    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
#<!--
import sys
import asyncio
import platform
import json
from pathlib import Path

# Stub window
if not hasattr(platform, 'window'):
    class MockWindow:
        def __getattr__(self, name): return None
    platform.window = MockWindow()

def update_bar(percent):
    try:
        platform.window.document.getElementById("progress-fill").style.width = f"{percent}%"
    except: pass

def show_error(msg):
    try:
        platform.window.document.getElementById("status-text").innerText = f"ERROR: {msg}"
        platform.window.document.getElementById("status-text").style.color = "#ff4500"
    except: pass

async def custom_site():
    try:
        # 1. Mount APK
        apk = "{{cookiecutter.archive}}.apk"
        bundle = "{{cookiecutter.archive}}"
        appdir = Path(f"/data/data/{bundle}")
        appdir.mkdir(parents=True, exist_ok=True)

        cfg = {"io": "url", "type": "mount", "mount": {"point": appdir.as_posix(), "path": "/"}, "path": f"/ => {appdir.as_posix()}"}
        
        if hasattr(platform.window, 'MM'):
            track = platform.window.MM.prepare(apk, json.dumps(cfg))
            while not track.ready:
                # Update Game Bar
                if track.len > 0:
                    p = int(track.pos / track.len * 100)
                    update_bar(p)
                await asyncio.sleep(0.05)
        
        update_bar(100)
        await asyncio.sleep(0.2) # Short pause to see 100%

        # 2. Setup Path
        if appdir.as_posix() not in sys.path:
            sys.path.append(appdir.as_posix())

        # 3. Remove Overlay
        try:
             platform.window.document.getElementById("boot-overlay").style.display = "none"
        except: pass

        # 4. Start Game
        import main
        await main.main()

    except Exception as e:
        show_error(str(e))
        import traceback
        traceback.print_exc()

# -->
    </script>
</body>
</html>
