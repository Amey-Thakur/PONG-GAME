<html lang="en-us">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AMEY & MEGA</title>
    <link rel="icon" type="image/png" href="favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; background-color: #050505; color: #eee; overflow: hidden; font-family: 'Outfit', sans-serif; user-select: none; -webkit-user-select: none; }
        
        /* Full screen overlay */
        #boot-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #050505; z-index: 99999999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }

        .logo-pulse {
            width: 120px; height: 120px; margin-bottom: 20px;
            animation: pulse 2s infinite ease-in-out;
            background: url('icon.png') no-repeat center; background-size: contain;
        }
        @keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.05); opacity: 1; } 100% { transform: scale(0.95); opacity: 0.8; } }

        .loading-text {
            font-size: 14px; color: #aaa; letter-spacing: 3px; text-transform: uppercase; margin-top: 15px; font-weight: bold;
        }

        /* GAME BAR - White */
        #progress-container { width: 300px; height: 6px; background: #222; margin-top: 20px; border-radius: 3px; overflow: hidden; }
        #progress-fill { width: 0%; height: 100%; background: #ffffff; transition: width 0.1s; } 

        #canvas { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); outline: none; z-index: 10; font-family: 'Outfit', sans-serif; }
        
        /* Ultra-Aggressive Suppression of everything else */
        body > :not(#boot-overlay):not(#canvas):not(script) { display: none !important; visibility: hidden !important; opacity: 0 !important; }
    </style>
</head>
<body>
    <div id="boot-overlay">
        <div class="logo-pulse"></div>
        <!-- Bar above Text -->
        <div id="progress-container"><div id="progress-fill"></div></div>
        <div class="loading-text" id="status-text">INITIALIZING PONG GAME...</div>
    </div>

    <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>

    <!-- JS Loader Visuals Only -->
    <script>
        // Fake visual progress to reassure user
        let progress = 0;
        const bar = document.getElementById('progress-fill');
        const interval = setInterval(() => {
            if (progress < 95) {
                progress += Math.random() * 2;
                bar.style.width = Math.min(progress, 95) + '%';
            }
        }, 100);

        window.finishVisuals = function() {
            clearInterval(interval);
            bar.style.width = '100%';
            // Allow a brief moment for the bar to look full before hiding
            setTimeout(() => {
                const overlay = document.getElementById('boot-overlay');
                if (overlay) overlay.style.display = 'none';
            }, 500);
        };
    </script>

    <script src="https://pygame-web.github.io/archives/0.9/pythons.js" 
            type=module id=site data-python="python3.11" data-os="vtx,fs,snd,gui" data-CONSOLE="0" async defer>
